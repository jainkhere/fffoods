    {
      "name": "Besan Chilla with Mint-Cilantro Chutney",
      "best_for": "Fresh Tuesday breakfast, light dinner, or high-protein snack.",
      "servings": "Makes 2 medium chillas.",
      "ingredients": {
        "Besan Chilla": [
          [
            "Besan / chickpea flour",
            "1/2 cup"
          ],
          [
            "Water",
            "1/3 to 1/2 cup, adjust as needed"
          ],
          [
            "Grated carrot",
            "2 tbsp"
          ],
          [
            "Chopped spinach or methi",
            "2 tbsp"
          ],
          [
            "Chopped onion",
            "1–2 tbsp, optional"
          ],
          [
            "Chopped cilantro",
            "1 tbsp"
          ],
          [
            "Ajwain",
            "1/4 tsp"
          ],
          [
            "Turmeric",
            "1/4 tsp"
          ],
          [
            "Cumin powder",
            "1/4 tsp"
          ],
          [
            "Hing",
            "Tiny pinch"
          ],
          [
            "Salt",
            "To taste"
          ],
          [
            "Oil",
            "1/2–1 tsp total"
          ]
        ],
        "Mint-Cilantro Chutney": [
          [
            "Cilantro",
            "1 cup"
          ],
          [
            "Mint",
            "1/2 cup"
          ],
          [
            "Ginger",
            "Small piece"
          ],
          [
            "Green chili",
            "Optional"
          ],
          [
            "Lemon juice",
            "1–2 tsp"
          ],
          [
            "Roasted chana dal",
            "1 tbsp, optional"
          ],
          [
            "Salt",
            "To taste"
          ],
          [
            "Water",
            "As needed"
          ]
        ]
      },
      "steps": [
        "Add besan, turmeric, cumin, ajwain, hing, and salt to a bowl.",
        "Slowly add water and whisk until smooth and pourable.",
        "Add grated carrot, spinach/methi, onion, and cilantro.",
        "Rest batter for 5–10 minutes if possible.",
        "Heat a nonstick pan and lightly grease.",
        "Pour batter and spread like a thin pancake.",
        "Cook on medium heat until the bottom is golden.",
        "Flip and cook the other side.",
        "Blend chutney ingredients with enough water to make a smooth chutney.",
        "Serve hot with chutney."
      ],
      "meal_prep_notes": [
        "Chilla batter is best fresh; can refrigerate up to 1 day.",
        "Mint-cilantro chutney keeps 2–3 days.",
        "Cooked chilla is best fresh but can be refrigerated 1 day."
